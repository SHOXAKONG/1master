# Copy this to .env on your VPS and fill in the values

# Your GitHub repo (e.g., shohruhbek/mytunnel)
GITHUB_REPO=your-github-username/mytunnel

# Your tunnel domain
TUNNEL_DOMAIN=tunnel.yourdomain.com

# Backend endpoint that validates a client's service token (returns the
# username used as the tunnel subdomain).
BACKEND_AUTH_URL=https://api.yourdomain.com/api/v1/tunnel/auth

# Cloudflare API token (for wildcard TLS certs)
CF_API_TOKEN=your-cloudflare-api-token

# Email for Let's Encrypt
ACME_EMAIL=you@example.com

# Optional: enable TLS on the client<->server control (9000) and data (9001)
# links so service tokens and proxied traffic are not sent in cleartext. Point
# these at a cert/key pair (e.g. the same Let's Encrypt cert Caddy issues).
# Clients then connect with `1master http <port> --tls`.
TUNNEL_TLS_CERT=
TUNNEL_TLS_KEY=
